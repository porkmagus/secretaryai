# Ignore dependencies
node_modules/
**/node_modules/

# Ignore runtime data
runtime/

# Ignore build output
.next/
dist/

# Ignore IDE/editor
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore git
.git/
.gitignore

# Ignore env files (they go in containers via env_file)
.env
.env.deploy
.env.local
.env.*.local

# Ignore docs
docs/
*.md
!README.md

# Ignore scripts (not needed in production image)
scripts/

# Ignore test files
**/*.test.ts
**/*.spec.ts
coverage/

# Ignore docker configs
docker/
