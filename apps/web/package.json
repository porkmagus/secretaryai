{
  "name": "@secretary/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @secretary/config && npm run build --workspace @secretary/core-runtime",
    "pretypecheck": "npm run build --workspace @secretary/config && npm run build --workspace @secretary/core-runtime",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@secretary/config": "0.1.0",
    "@secretary/core-runtime": "0.1.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  }
}
