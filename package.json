{
  "name": "secretary-first-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @secretary/config && npm run build --workspace @secretary/core-runtime && npm run build --workspace @secretary/integrations && npm run build --workspace @secretary/db && npm run build --workspace @secretary/observability",
    "build": "npm run build:packages && npm run build --workspace @secretary/web && npm run build --workspace @secretary/worker",
    "backup:create": "node scripts/backup/create-backup.mjs",
    "backup:restore": "node scripts/backup/restore-backup.mjs",
    "db:migrate": "npm run migrate --workspace @secretary/db",
    "dev:web": "npm run dev --workspace @secretary/web",
    "dev:worker": "npm run dev --workspace @secretary/worker",
    "deploy:config": "node scripts/setup/deploy-compose-runner.mjs config",
    "deploy:down": "node scripts/setup/deploy-compose-runner.mjs down",
    "deploy:logs": "node scripts/setup/deploy-compose-runner.mjs logs -f",
    "deploy:migrate": "node scripts/setup/deploy-compose-runner.mjs run --rm migrate",
    "deploy:up": "npm run storage:prepare && node scripts/setup/deploy-compose-runner.mjs up -d postgres redis searxng stt tts worker web proxy",
    "lint": "biome check apps/ packages/ scripts/ services/",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "export:settings": "node scripts/admin/export-settings.mjs",
    "import:settings": "node scripts/admin/import-settings.mjs",
    "phase1:verify": "node scripts/phase1/verify.mjs",
    "phase2:verify": "node scripts/phase2/verify.mjs",
    "phase3:verify": "node scripts/phase3/verify.mjs",
    "phase4:verify": "node scripts/phase4/verify.mjs",
    "phase4:verify:voice": "node scripts/phase4/verify-voice-note.mjs",
    "phase5:verify": "node scripts/phase5/verify.mjs",
    "phase6:verify": "node scripts/phase6/verify.mjs",
    "phase6:verify:agent-jobs": "node scripts/phase6/qualify-agent-jobs.mjs",
    "secretary:install": "node scripts/setup/secretary-dev-orchestrator.mjs install",
    "secretary:start": "node scripts/setup/secretary-dev-orchestrator.mjs start",
    "secretary:status": "node scripts/setup/secretary-dev-orchestrator.mjs status",
    "secretary:stop": "node scripts/setup/secretary-dev-orchestrator.mjs stop",
    "stt:setup": "node scripts/speech/setup-stt.mjs",
    "dev:stt": "node scripts/speech/run-stt.mjs",
    "tts:setup": "node scripts/speech/setup-tts.mjs",
    "dev:tts": "node scripts/speech/run-tts.mjs",
    "stack:down": "node scripts/setup/compose-runner.mjs down",
    "stack:up": "npm run storage:prepare && node scripts/setup/compose-runner.mjs up -d",
    "storage:prepare": "node scripts/setup/prepare-storage.mjs",
    "typecheck": "npm run typecheck --workspace @secretary/config && npm run typecheck --workspace @secretary/core-runtime && npm run typecheck --workspace @secretary/integrations && npm run typecheck --workspace @secretary/db && npm run typecheck --workspace @secretary/observability && npm run build:packages && npm run typecheck --workspace @secretary/web && npm run typecheck --workspace @secretary/worker",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "c8 npm run test --workspaces --if-present",
    "lint:ci": "biome ci ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "ai": "^6.0.141",
    "ai-sdk-provider-opencode-sdk": "^3.0.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "c8": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "*.{js,mjs}": "biome check --write --no-errors-on-unmatched",
    "*.json": "biome check --write --no-errors-on-unmatched"
  }
}
